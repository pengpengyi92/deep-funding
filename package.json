{
  "name": "deep-funding",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "deepfunding": "bin/deepfunding.mjs"
  },
  "scripts": {
    "cli": "node bin/deepfunding.mjs",
    "examples:generate": "tsx scripts/rsi-examples.ts",
    "examples:check": "tsx scripts/rsi-examples.ts --check",
    "start": "npm run db:local && npm run build && npm run dev",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:taxonomy": "tsx scripts/taxonomy-benchmark.ts",
    "benchmark:rsi": "tsx scripts/rsi-benchmark.ts",
    "schema:generate": "tsx scripts/funding-schema.ts",
    "schema:check": "tsx scripts/funding-schema.ts --check",
    "format": "prettier --write apps packages tests scripts data docs *.md *.ts *.json .github/workflows/*.yml",
    "dev": "wrangler dev --port 8791",
    "dev:web": "vite --host 127.0.0.1 --port 5191",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 migrations apply deep-funding --local",
    "db:remote": "wrangler d1 migrations apply deep-funding --remote",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run schema:check && npm run examples:check && npm run types && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.129.0"
  }
}
