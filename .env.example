# The MVP uses deterministic agents. No model API key is required.
# D1 is configured as a Worker binding in wrangler.jsonc.
# Never put secrets in VITE_* variables or commit .dev.vars.
# Optional Python backend override. The default is data/deep_funding.db under this repository.
# Set in the process environment; the Python launcher does not auto-load .env.
# DEEP_FUNDING_DATABASE_URL=sqlite:///data/deep_funding.db
# Private backend is loopback-only. Do not tunnel it or bind to a public interface.
